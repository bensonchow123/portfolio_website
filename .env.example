# Copy this file to .env and adjust as needed.

# Music data source.
SCROBBLE_VAULT_URL=http://127.0.0.1:8000

# Number of trusted proxies in front of Flask.
PROXY_FIX_HOPS=1

# Leave empty to disable rate limiting. Use redis:// or memcached:// otherwise.
RATELIMIT_STORAGE_URI=

# Published image tag.
SITE_TAG=latest

# Development only: match the host user for bind-mounted files.
# Use `id -u` and `id -g` if 1000:1000 is not correct.
# UID=1000
# GID=1000
