{
  "name": "profolio-website",
  "private": true,
  "version": "1.0.0",
  "description": "Tailwind build for the Flask portfolio. The Flask runtime never needs Node: static/css/tailwind.css is committed.",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/app.css -o ./static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/app.css -o ./static/css/tailwind.css --watch",
    "build:pdf": "python -m scripts.build_pdf",
    "build:images": "python -m scripts.build_images"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
